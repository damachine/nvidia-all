From 265151a39befabbfb3633a4f4dd15640db87b4d1 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Christian=20K=C3=BChn?= <damachin3@proton.me>
Date: Tue, 1 Sep 2026 15:25:35 +0200
Subject: [PATCH] kernel: Adapt dmem cgroup registration for Linux 7.3
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Linux 7.3 replaces the size argument to dmem_cgroup_register_region()
with a struct dmem_cgroup_init and interprets the region name as a
printf-style format string.

Initialize the new descriptor and pass the region name through a fixed
format string.

Signed-off-by: Christian Kühn <damachin3@proton.me>
---
 kernel-open/nvidia/os-interface.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/kernel-open/nvidia/os-interface.c b/kernel-open/nvidia/os-interface.c
index 2bf5a5d..b6eb5f6 100644
--- a/kernel-open/nvidia/os-interface.c
+++ b/kernel-open/nvidia/os-interface.c
@@ -2817,7 +2817,10 @@ NvU32 NV_API_CALL os_cgroup_implementation(void)
 
 void* NV_API_CALL os_dmem_cgroup_register_region(NvU64 size, const char *name)
 {
-    void *region = dmem_cgroup_register_region(size, name);
+    const struct dmem_cgroup_init init = {
+        .size = size,
+    };
+    void *region = dmem_cgroup_register_region(&init, "%s", name);
     if (IS_ERR(region))
     {
         return NULL;

-- 
2.55.0

